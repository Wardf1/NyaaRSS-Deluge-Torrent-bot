[Unit]
Description=Nyaa Transcode Worker
After=network-online.target deluged.service deluge-web.service
Wants=network-online.target

[Service]
Type=simple
User=example_user
Group=example_user
WorkingDirectory=/opt/nyaa-rss-deluge-bot/bot
ExecStart=/usr/bin/python3 /opt/nyaa-rss-deluge-bot/bot/transcode_worker.py --daemon --interval 30
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=utf-8
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/nyaa-rss-deluge-bot/bot /srv/media/downloads
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
