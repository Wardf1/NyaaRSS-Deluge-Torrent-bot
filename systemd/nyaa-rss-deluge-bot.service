[Unit]
Description=Nyaa RSS Deluge Bot
After=network-online.target deluged.service deluge-web.service
Wants=network-online.target

[Service]
Type=oneshot
User=example_user
Group=example_user
WorkingDirectory=/opt/nyaa-rss-deluge-bot/bot
ExecStart=/usr/bin/python3 /opt/nyaa-rss-deluge-bot/bot/bot.py
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=utf-8
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/nyaa-rss-deluge-bot/bot /srv/media/downloads
StandardOutput=journal
StandardError=journal
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
