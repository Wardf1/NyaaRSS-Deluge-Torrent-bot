{
  "rss_url": "https://nyaa.si/?page=rss",
  "deluge_url": "http://127.0.0.1:8112",
  "deluge_password": "CHANGE_ME",
  "dry_run": true,
  "default_download_location": "/srv/media/downloads",
  "only_configured_series": true,
  "torrent_options": {
    "add_paused": false
  },
  "trusted_only": false,
  "skip_remakes": false,
  "min_seeders": 0,
  "include_regex": [],
  "exclude_regex": [
    "480p",
    "720p"
  ],
  "recovery_metadata_per_run": 3,
  "discord_webhook": {
    "enabled": false,
    "url": "",
    "username": "Nyaa RSS Bot"
  },
  "discord_journal_webhook": {
    "enabled": false,
    "url": "",
    "username": "Nyaa RSS Logs",
    "send_after_runs": 30,
    "send_empty_logs": false,
    "max_file_size_mb": 7
  },
  "discord_transcode_webhook": {
    "enabled": false,
    "url": "",
    "username": "Nyaa Transcode Worker"
  },
  "series": {
    "Example HEVC Series|Example HEVC Alias": {
      "include_regex": [
        "\\A\\[ExampleGroup\\] Example HEVC Series - S\\d{2}E\\d{2,3} \\[1080p\\]\\[HEVC x265 10bit\\]\\[Multi-Subs\\](?:v\\d+)? \\(Weekly\\)\\Z"
      ],
      "trusted_only": false,
      "skip_remakes": false,
      "min_seeders": 0,
      "set_name": "[ExampleGroup] Example HEVC Series - {se}",
      "transcode": false
    },
    "Example AVC Series|Example AVC Alias": {
      "include_regex": [
        "\\A\\[ExampleGroup\\] Example AVC Series S\\d{2}E\\d{2,3} 1080p WEB-DL AAC2\\.0 H\\.264 \\(Multi-Subs\\)\\Z"
      ],
      "trusted_only": false,
      "skip_remakes": false,
      "min_seeders": 0,
      "set_name": "[ExampleGroup] Example AVC Series - {se}",
      "transcode": true
    }
  },
  "transcode": {
    "enabled": false,
    "queue_file": "transcode_queue.json",
    "ffmpeg_path": "ffmpeg",
    "ffprobe_path": "ffprobe",
    "output_container": "mkv",
    "hardware_acceleration": "none",
    "encoder": "libx265",
    "preset": "medium",
    "crf": 22,
    "pixel_format": "yuv420p10le",
    "audio_codec": "copy",
    "subtitle_codec": "copy",
    "attachment_codec": "copy",
    "delete_source_after_success": false,
    "keep_failed_output": false,
    "keep_completed_jobs": 100,
    "processing_stale_after": 21600,
    "max_duration_difference_seconds": 2.0,
    "rename_stream_titles": false,
    "default_stream_titles": false,
    "video_title": "",
    "audio_titles": {},
    "subtitles_titles": {}
  }
}
